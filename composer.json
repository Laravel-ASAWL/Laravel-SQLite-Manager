{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "asawl/laravel-sqlite-manager",
  "type": "library",
  "description": "Livewire-powered SQLite database manager for Laravel 12 applications.",
  "keywords": [
    "admin",
    "artisan",
    "database",
    "laravel",
    "laravel-package",
    "livewire",
    "sqlite"
  ],
  "homepage": "https://github.com/Laravel-ASAWL/Laravel-SQLite-Manager",
  "license": "MIT",
  "authors": [
    {
      "name": "Laravel ASAWL",
      "email": "webmaster@asawl.org",
      "homepage": "https://asawl.org",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/Laravel-ASAWL/Laravel-SQLite-Manager/issues",
    "source": "https://github.com/Laravel-ASAWL/Laravel-SQLite-Manager"
  },
  "require": {
    "php": "^8.2",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "illuminate/console": "^12.0",
    "illuminate/filesystem": "^12.0",
    "illuminate/http": "^12.0",
    "illuminate/routing": "^12.0",
    "illuminate/support": "^12.0",
    "illuminate/view": "^12.0",
    "livewire/livewire": "^3.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/framework": "^12.0",
    "laravel/pint": "^1.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Asawl\\LaravelSqliteManager\\": "LaravelSqliteManager/"
    },
    "exclude-from-classmap": [
      "LaravelSqliteManager/tests/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Asawl\\LaravelSqliteManager\\Tests\\": "LaravelSqliteManager/tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Asawl\\LaravelSqliteManager\\SQLiteManagerServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "pest",
    "analyse": "phpstan analyse",
    "format": "pint",
    "format:check": "pint --test"
  },
  "archive": {
    "exclude": [
      "/LaravelSqliteManager/tests",
      "/.github",
      "/node_modules",
      "/vendor"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
